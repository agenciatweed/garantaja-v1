---
interface Props {
  href: string;
  variante?: 'primario' | 'contorno' | 'texto' | 'azul' | 'amarelo';
  tamanho?: 'grande' | 'medio';
  class?: string;
}
const { href, variante = 'primario', tamanho = 'grande', class: extra = '' } = Astro.props;
---

<a href={href} class:list={['botao', variante, tamanho, extra]}>
  <slot />
</a>

<style>
  .botao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-xs);
    border-radius: var(--r-pill);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
    transition: background 150ms ease-out, color 150ms ease-out, transform 120ms ease-out;
  }
  .grande { min-height: 56px; padding: 16px 32px; font-size: 1.125rem; }
  .medio { min-height: 48px; padding: 12px 24px; font-size: 1rem; }
  .botao:active { transform: scale(0.98); }

  .primario { background: var(--verde-acao); color: var(--branco); }
  .primario:hover { background: var(--verde-acao-profundo); color: var(--branco); }

  .contorno { background: transparent; color: var(--azul); box-shadow: inset 0 0 0 2px var(--azul); }
  .contorno:hover { background: var(--azul-suave); color: var(--azul-profundo); }

  .texto { background: transparent; color: var(--azul); }
  .texto:hover { background: var(--azul-suave); color: var(--azul-profundo); }

  .azul { background: var(--azul); color: var(--branco); }
  .azul:hover { background: var(--azul-profundo); color: var(--branco); }

  .amarelo { background: var(--amarelo); color: var(--azul); }
  .amarelo:hover { background: var(--amarelo-pressionado); color: var(--azul-profundo); }
</style>
