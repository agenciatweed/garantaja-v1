---
interface Props {
  tipo?: 'destaque' | 'aprovado' | 'neutro';
  class?: string;
}
const { tipo = 'destaque', class: extra = '' } = Astro.props;
---

<span class:list={['chip', tipo, extra]}>
  {tipo === 'aprovado' && (
    <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="8" fill="currentColor" />
      <path d="M4.5 8.3l2.3 2.3 4.7-4.9" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  <slot />
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-xs);
    border-radius: var(--r-pill);
    padding: 6px 14px;
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }
  .destaque { background: var(--amarelo); color: var(--cinza-escuro); font-weight: 600; }
  .aprovado { background: var(--verde-suave); color: var(--verde-acao-profundo); }
  .aprovado svg { color: var(--verde); }
  .neutro { background: var(--cinza-claro); color: var(--cinza-medio); }
</style>
