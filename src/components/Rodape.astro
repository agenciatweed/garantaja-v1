---
import { empresa, contato, bandeiras } from '../data/preview';

const colunas = [
  {
    titulo: 'o produto',
    itens: [
      { href: '/como-funciona', label: 'como funciona' },
      { href: '/duvidas', label: 'dúvidas' },
      { href: '/simulador', label: 'simular' },
      { href: '/blog', label: 'conteúdos' },
    ],
  },
  {
    titulo: 'confiança',
    itens: [
      { href: '/seguranca', label: 'segurança' },
      { href: '/atendimento', label: 'atendimento' },
      { href: '/seguranca#participantes', label: 'quem participa da operação' },
      { href: '/acompanhar', label: 'acompanhar operação' },
    ],
  },
  {
    titulo: 'legal',
    itens: [
      { href: '/termos', label: 'termos de uso' },
      { href: '/privacidade', label: 'política de privacidade' },
      { href: '/privacidade#lgpd', label: 'LGPD' },
    ],
  },
];
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container grade">
    <div class="marca-col">
      <img src="/img/logo-branco.svg" alt="Garanta Já" width="200" height="30" class="marca" />
      <p class="descritivo">crédito simples, rápido e possível. use seu limite disponível e receba por Pix.</p>
      <a href={`mailto:${contato.email}`} class="email">{contato.email}</a>
    </div>

    {colunas.map((c) => (
      <div class="col">
        <h2 class="titulo-col">{c.titulo}</h2>
        <ul>{c.itens.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    ))}
  </div>

  <div class="container base">
    <ul class="bandeiras" aria-label="bandeiras aceitas">
      {bandeiras.map((b) => <li>{b}</li>)}
    </ul>
    <div class="legal">
      <p>
        garanta já é um produto {empresa.razaoSocial} · cnpj <span class="tabular">{empresa.cnpj}</span>.
        a identificação das demais empresas participantes e as informações legais obrigatórias
        são publicadas conforme orientação jurídica. condições, parcelas e CET são apresentados
        antes da contratação.
      </p>
      <p>© {ano} Garanta Já.</p>
    </div>
  </div>
</footer>

<style>
  .rodape {
    background: var(--cinza-escuro);
    color: var(--branco);
    padding-block: clamp(40px, 5vw, 60px) var(--s-2xl);
  }
  .grade {
    display: grid;
    gap: var(--s-xl);
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  }
  .marca { width: 190px; height: auto; margin-bottom: var(--s-md); }
  .descritivo { color: var(--escuro-texto); max-width: 30ch; font-size: var(--fs-body-sm); margin-bottom: var(--s-sm); }
  .email {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--escuro-texto); font-size: var(--fs-body-sm); text-decoration: none;
  }
  .email:hover { color: var(--amarelo); }

  .titulo-col {
    font-size: var(--fs-body-sm); font-weight: 700;
    color: var(--amarelo); margin-bottom: var(--s-xs);
  }
  .col ul { display: flex; flex-direction: column; }
  .col li a {
    display: flex; align-items: center; min-height: 40px;
    color: var(--branco); text-decoration: none; font-size: var(--fs-body-sm);
  }
  .col li a:hover { color: var(--amarelo); }

  .base {
    margin-top: var(--s-xl);
    padding-top: var(--s-lg);
    border-top: 1px solid var(--escuro-linha);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-lg);
    align-items: flex-start;
    justify-content: space-between;
  }
  .bandeiras { display: flex; gap: var(--s-xs); flex-wrap: wrap; }
  .bandeiras li {
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 10px;
    padding: 7px 13px;
    font-size: var(--fs-micro);
    font-weight: 600;
    color: var(--escuro-texto);
  }
  .legal {
    display: grid;
    gap: var(--s-xs);
    max-width: 66ch;
    font-size: var(--fs-micro);
    line-height: 1.6;
    color: var(--escuro-suave);
  }
</style>
