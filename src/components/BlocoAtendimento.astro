---
import Botao from './Botao.astro';
import { contato } from '../data/preview';
---

<div class="bloco">
  <div>
    <h2 class="titulo">ficou com alguma dúvida?</h2>
    <p class="texto">fale com a gente pelos canais oficiais. {contato.horario}.</p>
  </div>
  <div class="acoes">
    <Botao href={contato.whatsappLink ?? '/atendimento'} variante="amarelo">falar no WhatsApp</Botao>
    <a href="/atendimento" class="outros">
      outros canais
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
    </a>
  </div>
</div>

<style>
  .bloco {
    background: var(--cinza-escuro);
    border-radius: var(--r-2xl);
    padding: clamp(28px, 4.5vw, 48px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-lg);
    align-items: center;
  }
  .titulo { font-size: clamp(1.5rem, 3vw, 2.125rem); font-weight: 800; color: var(--branco); margin-bottom: 10px; }
  .texto { color: #E6EAEF; font-size: var(--fs-body); max-width: 40ch; }
  .acoes { display: flex; gap: 20px; flex-wrap: wrap; align-items: center; justify-self: start; }
  .outros {
    display: inline-flex; align-items: center; gap: var(--s-xs);
    min-height: 48px;
    color: var(--branco); font-weight: 700; font-size: 1.0625rem;
    text-decoration: underline; text-underline-offset: 4px;
  }
  .outros:hover { color: var(--amarelo); }
</style>
