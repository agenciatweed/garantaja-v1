---
const links = [
  { href: '/como-funciona', label: 'como funciona' },
  { href: '/duvidas', label: 'dúvidas' },
  { href: '/seguranca', label: 'segurança' },
  { href: '/atendimento', label: 'atendimento' },
  { href: '/blog', label: 'conteúdos' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const atual = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="nav" id="nav">
  <div class="container nav-inner">
    <a href="/" class="marca" aria-label="Garanta Já — página inicial">
      <img src="/img/logo.svg" alt="Garanta Já" width="210" height="32" />
    </a>

    <nav class="links" aria-label="navegação principal">
      {links.map((l) => (
        <a href={l.href} class:list={['link', { ativo: atual(l.href) }]} aria-current={atual(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="acoes">
      <a href="/simulador" class="cta">simular</a>
      <button class="hamburguer" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="abrir menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu-mobile" id="menu-mobile" hidden>
    <nav aria-label="menu">
      {links.map((l) => (
        <a href={l.href} class:list={['item', { ativo: atual(l.href) }]} aria-current={atual(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="/acompanhar" class="item">acompanhar operação</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--linha);
  }
  @supports (backdrop-filter: blur(8px)) {
    .nav { backdrop-filter: blur(8px); }
  }

  .nav-inner {
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: var(--s-lg);
  }
  .marca { display: flex; align-items: center; flex: none; }
  .marca img { height: 28px; width: auto; }

  .links { display: none; gap: var(--s-2xs); margin-left: auto; }
  .link {
    color: var(--azul);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    padding: 9px 14px;
    border-radius: var(--r-pill);
    transition: background 140ms ease-out;
  }
  .link:hover { background: var(--cinza-claro); color: var(--azul); }
  .link.ativo { background: var(--azul-suave); font-weight: 700; }

  .acoes { display: flex; align-items: center; gap: var(--s-xs); flex: none; margin-left: auto; }
  .cta {
    background: var(--verde-acao);
    color: var(--branco);
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    padding: 12px 24px;
    border-radius: var(--r-pill);
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    transition: background 150ms ease-out;
  }
  .cta:hover { background: var(--verde-acao-profundo); color: var(--branco); }

  .hamburguer {
    width: 48px; height: 48px;
    display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px;
    background: none; border: 0; cursor: pointer; padding: 0;
    border-radius: var(--r-md);
  }
  .hamburguer span { width: 22px; height: 2px; background: var(--azul); border-radius: var(--r-pill); transition: transform 200ms var(--ease), opacity 200ms var(--ease); }
  .hamburguer[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburguer[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .hamburguer[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .menu-mobile { border-top: 1px solid var(--linha); background: var(--branco); }
  .menu-mobile nav { display: flex; flex-direction: column; padding: var(--s-xs) var(--gutter) var(--s-lg); }
  .menu-mobile .item {
    display: flex; align-items: center;
    min-height: 56px;
    font-size: 1.125rem; font-weight: 500;
    color: var(--azul); text-decoration: none;
    border-bottom: 1px solid var(--linha);
  }
  .menu-mobile .item.ativo { font-weight: 700; }
  .menu-mobile .item:last-child { border-bottom: 0; }

  @media (max-width: 380px) {
    .marca img { height: 24px; }
    .cta { padding: 12px 18px; }
  }

  @media (min-width: 1024px) {
    .marca img { height: 32px; }
    .links { display: flex; }
    .acoes { margin-left: 0; }
    .hamburguer { display: none; }
    .menu-mobile { display: none !important; }
  }
</style>

<script>
  const botao = document.querySelector<HTMLButtonElement>('#nav .hamburguer');
  const menu = document.getElementById('menu-mobile');

  botao?.addEventListener('click', () => {
    const aberto = botao.getAttribute('aria-expanded') === 'true';
    botao.setAttribute('aria-expanded', String(!aberto));
    botao.setAttribute('aria-label', aberto ? 'abrir menu' : 'fechar menu');
    if (menu) menu.hidden = aberto;
  });
</script>
