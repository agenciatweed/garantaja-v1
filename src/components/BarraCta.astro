---
import Botao from './Botao.astro';
---

<div class="barra">
  <span class="texto">veja quanto você pode receber</span>
  <Botao href="/simulador" tamanho="medio">simular agora</Botao>
</div>

<style>
  .barra {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: rgba(255, 255, 255, 0.97);
    border-top: 1px solid var(--linha);
    box-shadow: var(--sombra-barra);
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: var(--s-md);
    justify-content: center;
  }
  .barra :global(.botao) { white-space: nowrap; flex: none; }
  .texto { font-size: var(--fs-body-sm); font-weight: 600; color: var(--azul); }
  @media (max-width: 420px) {
    .barra :global(.botao) { white-space: nowrap; flex: none; }
  .texto { font-size: var(--fs-small); line-height: 1.3; }
  }
  :global(.rodape) { padding-bottom: 110px !important; }
</style>
