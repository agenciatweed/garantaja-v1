---
import BaseLayout from '../layouts/BaseLayout.astro';
import Botao from '../components/Botao.astro';
import Participantes from '../components/Participantes.astro';
import { empresa } from '../data/preview';

const selos = ['LGPD', 'SSL', 'criptografia'];

const pilares = [
  {
    t: 'tecnologia',
    d: 'conexão protegida por criptografia, validação de identidade e contrato com assinatura digital.',
  },
  {
    t: 'compromisso',
    d: 'seus dados servem só para validar sua identidade e formalizar a operação, conforme a LGPD. e tem gente de verdade no atendimento durante toda a jornada.',
  },
];

const cobranca = [
  {
    t: 'o título garante a operação',
    d: 'o título de capitalização é comprado no seu cartão, parcelado. é ele que garante o crédito — sem garantia, não existe operação.',
  },
  {
    t: 'por isso ele vem primeiro',
    d: 'a garantia precisa existir antes de o dinheiro ser liberado. você vê o valor e as parcelas dessa compra antes de confirmar.',
  },
  {
    t: 'não deu certo? estorno',
    d: 'se a operação não for concluída, a compra do título é estornada no seu cartão.',
  },
];

const nunca = [
  'pedir pix, boleto ou depósito para “liberar” o dinheiro',
  'cobrar taxa de análise, de cadastro ou de desbloqueio',
  'pedir a senha do seu cartão, do seu banco ou do seu e-mail',
  'pedir o código de verificação que chegou no seu celular',
];
---

<BaseLayout
  title="Segurança e transparência — Garanta Já"
  description="Como o Garanta Já protege seus dados, por que a cobrança do título vem antes do dinheiro e quem participa da operação."
>
  <div class="pagina topo">
    <a href="/" class="voltar">← início</a>
    <h1 class="t-pagina">segurança e transparência.</h1>
    <p class="intro">como seus dados são protegidos, o que você vê antes de decidir e quem participa da operação.</p>
  </div>

  <section class="container painel-secao">
    <div class="painel">
      <span class="cadeado" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2.5" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /><path d="M12 15v2" /></svg>
      </span>
      <h2 class="painel-titulo">sua segurança vem primeiro.</h2>
      <ul class="selos" aria-label="proteções">
        {selos.map((s) => <li>{s}</li>)}
      </ul>
      <p class="painel-texto">
        o Garanta Já é 100% digital. cada etapa da operação é protegida, e você vê
        todas as condições antes de confirmar qualquer coisa.
      </p>
      <ul class="pilares">
        {pilares.map((p) => (
          <li>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container secao">
    <p class="olho">transparência</p>
    <h2 class="t-secao titulo">por que a cobrança no cartão vem antes do dinheiro?</h2>
    <p class="t-lead suave subtitulo">é a parte que mais gera dúvida — então a gente explica.</p>
    <ol class="cobranca">
      {cobranca.map((c, i) => (
        <li class="cartao">
          <span class="numero" aria-hidden="true">{i + 1}</span>
          <h3 class="t-card">{c.t}</h3>
          <p>{c.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="fundo-claro secao">
    <div class="container duas">
      <div>
        <h2 class="t-secao titulo">o que a gente nunca vai pedir.</h2>
        <p class="t-body subtitulo">
          a única cobrança do Garanta Já é a do título, no seu cartão, dentro da
          contratação oficial. se alguém pedir qualquer coisa abaixo em nosso nome,
          não é a gente.
        </p>
      </div>
      <ul class="nunca">
        {nunca.map((n) => (
          <li>
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#C0392B" /><path d="M8.5 8.5l7 7M15.5 8.5l-7 7" stroke="#fff" stroke-width="2.2" stroke-linecap="round" /></svg>
            <span>{n}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container secao" id="participantes">
    <p class="olho">quem participa</p>
    <h2 class="t-secao titulo">entenda quem participa da operação.</h2>
    <p class="t-lead suave subtitulo">
      o garanta já é a marca que acompanha você na experiência. empresas especializadas
      participam da estrutura da operação.
    </p>
    <Participantes />

    <div class="responsavel">
      <h3>empresa responsável</h3>
      <dl class="tabular">
        <div><dt>razão social</dt><dd>{empresa.razaoSocial}</dd></div>
        <div><dt>cnpj</dt><dd>{empresa.cnpj}</dd></div>
      </dl>
      <p class="suave">esse cnpj pode ser consultado gratuitamente no site da Receita Federal.</p>
    </div>

    <div class="acoes">
      <Botao href="/simulador">simular agora</Botao>
      <Botao href="/atendimento" variante="texto">falar com o atendimento</Botao>
    </div>
  </section>
</BaseLayout>

<style>
  .topo { padding-bottom: 0; }
  .painel-secao { padding-top: 64px; }
  .painel {
    position: relative;
    background: var(--azul);
    color: var(--branco);
    border-radius: var(--r-2xl);
    padding: 72px clamp(24px, 5vw, 56px) clamp(28px, 5vw, 48px);
    text-align: center;
  }
  .cadeado {
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    width: 84px; height: 84px;
    border-radius: 50%;
    background: var(--amarelo);
    color: var(--azul);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 8px var(--branco);
  }
  .painel-titulo {
    color: var(--amarelo);
    font-size: clamp(1.625rem, 3.6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .selos {
    display: flex; justify-content: center; flex-wrap: wrap;
    gap: var(--s-xs);
    margin: var(--s-md) 0 var(--s-lg);
  }
  .selos li {
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--r-pill);
    padding: 5px 14px;
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .painel-texto { max-width: 52ch; margin-inline: auto; font-size: var(--fs-body); font-weight: 500; }
  .pilares {
    margin-top: var(--s-xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--s-md);
    max-width: 720px;
    margin-inline: auto;
  }
  .pilares li {
    border: 1.5px solid rgba(255, 196, 0, 0.7);
    border-radius: var(--r-xl);
    padding: 22px;
  }
  .pilares h3 { color: var(--amarelo); font-size: 1.125rem; font-weight: 800; margin-bottom: var(--s-xs); }
  .pilares p { font-size: var(--fs-body-sm); line-height: 1.55; }

  .titulo { margin-bottom: 10px; max-width: 26ch; }
  .subtitulo { margin-bottom: var(--s-xl); }

  .cobranca {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 20px;
  }
  .numero {
    display: flex; width: 40px; height: 40px; border-radius: 50%;
    background: var(--amarelo); color: var(--azul);
    font-weight: 800; align-items: center; justify-content: center;
    margin-bottom: var(--s-md);
  }
  .cobranca li:last-child .numero { background: var(--verde-acao); color: var(--branco); }

  .duas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--s-xl);
    align-items: center;
  }
  .duas .subtitulo { margin-bottom: 0; }
  .nunca { display: grid; gap: var(--s-sm); }
  .nunca li {
    display: flex; gap: var(--s-sm); align-items: flex-start;
    background: var(--branco);
    border-radius: var(--r-lg);
    padding: 14px 16px;
    font-weight: 500;
  }
  .nunca svg { flex: none; }

  .responsavel {
    margin-top: var(--s-xl);
    background: var(--cinza-claro);
    border-radius: var(--r-xl);
    padding: 26px;
    max-width: 640px;
  }
  .responsavel h3 { font-size: 1.125rem; font-weight: 700; margin-bottom: var(--s-sm); }
  .responsavel dl { display: grid; gap: var(--s-xs); margin-bottom: var(--s-sm); }
  .responsavel dl > div { display: flex; justify-content: space-between; gap: var(--s-md); flex-wrap: wrap; }
  .responsavel dt { color: var(--cinza-medio); }
  .responsavel dd { margin: 0; font-weight: 600; }
  .responsavel p { font-size: var(--fs-body-sm); }

  .acoes { margin-top: var(--s-xl); display: flex; gap: var(--s-sm); flex-wrap: wrap; }
</style>
