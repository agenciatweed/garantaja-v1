---
import BaseLayout from '../layouts/BaseLayout.astro';
import Botao from '../components/Botao.astro';
import BlocoAzul from '../components/BlocoAzul.astro';
import Foto from '../components/Foto.astro';
import Chip from '../components/Chip.astro';
import { empresa, contato, fotos } from '../data/preview';

const nunca = [
  'pedir depósito antecipado para “liberar” o crédito',
  'cobrar taxa de análise, de cadastro ou de desbloqueio',
  'pedir pix para conta de pessoa física',
  'pedir a senha do seu cartão, do seu banco ou do seu e-mail',
  'ligar pedindo código de verificação que chegou no seu celular',
];
---

<BaseLayout
  title="Segurança e confiança — Garanta Já"
  description="Quem responde pelo Garanta Já, quais são os canais oficiais e o que a empresa nunca vai pedir de você."
>
  <section class="secao capa">
    <div class="container">
      <h1 class="t-display">quem está<br />por trás disto.</h1>
      <p class="t-lead sub">
        você chegou aqui desconfiado, e isso é sensato. esta página existe pra
        você conferir, não pra você acreditar.
      </p>
    </div>
  </section>

  <section class="secao-curta">
    <div class="container">
      <div class="identidade">
        <h2 class="t-title">a empresa responsável</h2>
        <dl class="dados tabular">
          <div><dt>razão social</dt><dd>{empresa.razaoSocial}</dd></div>
          <div><dt>nome fantasia</dt><dd>{empresa.nomeFantasia}</dd></div>
          <div><dt>cnpj</dt><dd>{empresa.cnpj}</dd></div>
        </dl>
        <p class="conferir">
          esse cnpj pode ser consultado gratuitamente no site da Receita Federal.
          a gente recomenda que você faça isso.
        </p>
      </div>
    </div>
  </section>

  <section class="secao fundo-claro">
    <div class="container duas">
      <div>
        <h2 class="t-headline">a gente nunca vai pedir isso</h2>
        <p class="t-body suave espaco">
          golpe de crédito no Brasil tem quase sempre o mesmo roteiro: pedem
          um valor antes de liberar o dinheiro. o Garanta Já não faz nada disso.
        </p>
        <ul class="nunca">
          {nunca.map((n) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <circle cx="10" cy="10" r="10" fill="#C0392B" />
                <path d="M6.5 6.5l7 7M13.5 6.5l-7 7" stroke="#fff" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span>{n}</span>
            </li>
          ))}
        </ul>
        <p class="alerta">
          se alguém fizer qualquer um desses pedidos em nome do Garanta Já,
          não é o Garanta Já. fale com a gente pelo canal oficial abaixo.
        </p>
      </div>
      <Foto src={fotos.conferindo} alt="homem conferindo com calma um documento impresso" proporcao="2:1" />
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <BlocoAzul titulo="canais oficiais">
        <p>
          estes são os únicos canais do Garanta Já. qualquer contato que venha
          de outro número, outro domínio ou outro perfil não é oficial.
        </p>
        <ul class="canais">
          <li><span class="canal-rotulo">whatsapp</span> <a href={contato.whatsappLink}>{contato.whatsappExibicao}</a></li>
          <li><span class="canal-rotulo">e-mail</span> <a href={`mailto:${contato.email}`}>{contato.email}</a></li>
          <li><span class="canal-rotulo">site</span> <span class="tabular">{contato.dominio}</span></li>
        </ul>
        <p class="provisorio">
          <Chip tipo="destaque">prévia</Chip>
          estes contatos ainda são provisórios e serão substituídos pelos canais
          definitivos antes do lançamento.
        </p>
      </BlocoAzul>
    </div>
  </section>

  <section class="secao fundo-claro">
    <div class="container pendencias">
      <h2 class="t-headline">o que ainda vai ser publicado aqui</h2>
      <p class="t-lead suave espaco">
        a gente prefere deixar o espaço vazio a preencher com informação que
        ainda não foi confirmada.
      </p>
      <ul class="lista-pendente">
        <li>registro susep do título de capitalização</li>
        <li>identificação da sociedade emissora do título</li>
        <li>condição de correspondente bancário, quando aplicável</li>
        <li>horário e equipe de atendimento</li>
      </ul>
      <Botao href="/simulador">simular agora</Botao>
    </div>
  </section>
</BaseLayout>

<style>
  .capa h1 { text-wrap: balance; }
  .capa .sub { margin-top: var(--s-lg); color: var(--cinza-medio); }

  .identidade {
    background: var(--cinza-claro);
    border-radius: var(--r-xl);
    padding: clamp(24px, 5vw, 40px);
    max-width: 46rem;
  }
  .dados { margin-top: var(--s-lg); display: grid; gap: var(--s-sm); }
  .dados > div { display: flex; justify-content: space-between; gap: var(--s-md); flex-wrap: wrap; }
  .dados dt { color: var(--cinza-medio); }
  .dados dd { margin: 0; font-weight: 600; }
  .conferir { margin-top: var(--s-lg); font-size: var(--fs-body-sm); color: var(--cinza-medio); max-width: 54ch; }

  .duas { display: grid; gap: var(--s-xl); align-items: center; }
  .espaco { margin-top: var(--s-md); }
  .nunca { margin-top: var(--s-lg); display: grid; gap: var(--s-sm); }
  .nunca li { display: flex; gap: var(--s-sm); align-items: flex-start; }
  .nunca svg { flex: none; margin-top: 0.2em; }
  .alerta {
    margin-top: var(--s-lg);
    font-weight: 500;
    max-width: 56ch;
  }
  @media (min-width: 1024px) {
    .duas { grid-template-columns: 1.15fr 0.85fr; gap: var(--s-3xl); }
  }

  .canais { margin-top: var(--s-lg); display: grid; gap: var(--s-sm); }
  .canais li { display: flex; gap: var(--s-sm); flex-wrap: wrap; align-items: baseline; }
  .canal-rotulo {
    font-size: var(--fs-micro); letter-spacing: 0.06em; font-weight: 500;
    color: var(--amarelo); min-width: 8ch;
  }
  .canais a { color: var(--branco); font-weight: 600; text-decoration-color: rgba(255,255,255,0.45); }
  .canais a:hover { color: var(--amarelo); }
  .provisorio {
    margin-top: var(--s-lg);
    display: flex; gap: var(--s-sm); align-items: center; flex-wrap: wrap;
    font-size: var(--fs-body-sm);
  }

  .lista-pendente { margin-top: var(--s-lg); margin-bottom: var(--s-xl); display: grid; gap: var(--s-sm); max-width: 54ch; }
  .lista-pendente li {
    color: var(--cinza-medio);
    padding-left: var(--s-lg);
    position: relative;
  }
  .lista-pendente li::before {
    content: '';
    position: absolute; left: 0; top: 0.7em;
    width: 10px; height: 2px; border-radius: var(--r-pill);
    background: var(--linha-forte);
  }
</style>
