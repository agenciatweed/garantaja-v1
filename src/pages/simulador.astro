---
import BaseLayout from '../layouts/BaseLayout.astro';
import { condicoes, parcela, brl, brlInteiro } from '../data/preview';

const v0 = condicoes.valorInicial;
const n0 = condicoes.parcelasIniciais;
const p0 = parcela(v0, n0);
---

<BaseLayout
  title="Simulador — Garanta Já"
  description="Veja quanto você recebe por Pix, as parcelas no cartão e o CET antes de decidir. Simular é grátis e não gera cobrança."
>
  <div class="fundo">
    <div class="container">
      <a href="/" class="voltar">← início</a>

      <form
        class="simulador"
        id="sim"
        novalidate
        data-taxa={condicoes.taxaMensal}
        onsubmit="return false"
      >
        <p class="rotulo">simulador · demonstração</p>
        <h1 class="titulo">quanto você quer receber?</h1>

        <output class="valor tabular" id="saida-valor" for="valor">{brlInteiro(v0)}</output>
        <p class="valor-legenda">valor que cai na sua conta por Pix</p>

        <input
          id="valor"
          type="range"
          min={condicoes.valorMinimo}
          max={condicoes.valorMaximo}
          step={condicoes.valorPasso}
          value={v0}
          aria-label="valor que você quer receber, em reais"
          aria-valuetext={brlInteiro(v0)}
        />
        <div class="limites tabular" aria-hidden="true">
          <span>{brlInteiro(condicoes.valorMinimo)}</span>
          <span>{brlInteiro(condicoes.valorMaximo)}</span>
        </div>

        <fieldset class="parcelas">
          <legend>em quantas vezes no cartão?</legend>
          <div class="opcoes">
            {condicoes.opcoesParcelas.map((n) => (
              <label class="opcao">
                <input type="radio" name="parcelas" value={n} checked={n === n0} />
                <span>{n}x</span>
              </label>
            ))}
          </div>
        </fieldset>

        <dl class="resultado tabular" aria-live="polite">
          <div><dt>você recebe</dt><dd id="r-recebe">{brl(v0)}</dd></div>
          <div><dt>forma de recebimento</dt><dd>Pix</dd></div>
          <div><dt>parcelas no cartão</dt><dd id="r-n">{n0}x</dd></div>
          <div><dt>total da operação</dt><dd id="r-total">{brl(p0 * n0)}</dd></div>
          <div><dt>CET (exemplo)</dt><dd>{condicoes.cetMensal}</dd></div>
          <div class="parcela"><dt>parcela</dt><dd id="r-parcela">{n0}x de {brl(p0)}</dd></div>
        </dl>

        <p class="mesma-taxa">a taxa é a mesma para qualquer perfil — só varia conforme o valor escolhido.</p>

        <button type="button" class="avancar" id="avancar">continuar com essas condições</button>

        <div class="handoff" id="handoff" hidden role="status">
          <h2>a contratação ainda não está ligada</h2>
          <p>
            a jornada de contratação está sendo construída pela equipe de tecnologia.
            quando ela existir, este botão leva direto pra lá — com as mesmas cores,
            botões e linguagem, e com os parâmetros de campanha preservados.
          </p>
        </div>

        <p class="nota">
          valores ilustrativos desta prévia. as condições reais, incluindo o valor do título
          de capitalização, aparecem na contratação, antes de você confirmar.
        </p>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  .fundo { background: var(--cinza-claro); padding-block: 24px clamp(44px, 6vw, 80px); }
  .fundo .container { max-width: 600px; }

  .simulador {
    margin-top: var(--s-xs);
    background: var(--branco);
    border-radius: var(--r-2xl);
    box-shadow: var(--sombra-elevada);
    padding: clamp(22px, 5vw, 32px);
  }
  .rotulo { font-size: var(--fs-micro); font-weight: 600; color: var(--cinza-medio); }
  .titulo { font-size: clamp(1.5rem, 4vw, 1.75rem); font-weight: 800; margin-top: 2px; }

  .valor {
    display: block;
    text-align: center;
    margin-top: var(--s-lg);
    font-size: clamp(2.5rem, 9vw, 3rem);
    font-weight: 800;
    color: var(--azul);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .valor-legenda { text-align: center; font-size: var(--fs-small); color: var(--cinza-medio); margin-top: 4px; }

  input[type='range'] {
    width: 100%;
    height: 44px;
    margin-top: var(--s-md);
    background: none;
    -webkit-appearance: none;
    appearance: none;
    --pct: 58%;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 8px; border-radius: var(--r-pill);
    background: linear-gradient(to right, var(--verde-acao) var(--pct), var(--linha) var(--pct));
  }
  input[type='range']::-moz-range-track { height: 8px; border-radius: var(--r-pill); background: var(--linha); }
  input[type='range']::-moz-range-progress { height: 8px; border-radius: var(--r-pill); background: var(--verde-acao); }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 28px; height: 28px; margin-top: -10px;
    border-radius: 50%; background: var(--branco);
    border: 2px solid var(--linha-forte);
    box-shadow: var(--sombra-card); cursor: pointer;
  }
  input[type='range']::-moz-range-thumb {
    width: 26px; height: 26px;
    border-radius: 50%; background: var(--branco);
    border: 2px solid var(--linha-forte); cursor: pointer;
  }
  .limites { display: flex; justify-content: space-between; font-size: var(--fs-micro); font-weight: 600; color: var(--cinza-medio); }

  .parcelas { border: 0; margin: var(--s-lg) 0 0; padding: 0; }
  .parcelas legend { font-size: var(--fs-small); font-weight: 600; color: var(--cinza-medio); padding: 0; margin-bottom: var(--s-sm); }
  .opcoes { display: flex; gap: var(--s-xs); flex-wrap: wrap; }
  .opcao { position: relative; }
  .opcao input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
  .opcao span {
    display: flex; align-items: center; justify-content: center;
    min-width: 64px; min-height: 48px; padding: 0 var(--s-md);
    border-radius: var(--r-pill);
    border: 1.5px solid var(--linha);
    font-weight: 700; color: var(--cinza-medio);
    font-variant-numeric: tabular-nums;
    transition: background 140ms ease-out, border-color 140ms ease-out, color 140ms ease-out;
  }
  .opcao input:checked + span { border-color: var(--azul); background: var(--azul-suave); color: var(--azul); }
  .opcao input:focus-visible + span { outline: 3px solid var(--azul); outline-offset: 2px; }

  .resultado {
    margin: var(--s-lg) 0 0;
    background: var(--cinza-claro);
    border-radius: var(--r-xl);
    padding: 6px var(--s-md);
  }
  .resultado > div {
    display: flex; justify-content: space-between; gap: var(--s-md);
    padding: 12px 0;
    border-bottom: 1px solid var(--linha);
    font-size: var(--fs-body-sm);
  }
  .resultado > div:last-child { border-bottom: 0; }
  .resultado dt { font-weight: 500; }
  .resultado dd { margin: 0; font-weight: 700; color: var(--azul); text-align: right; }
  .resultado .parcela { padding-block: 14px; }
  .resultado .parcela dt { font-weight: 800; color: var(--cinza-escuro); }
  .resultado .parcela dd { font-size: 1.1875rem; font-weight: 800; color: var(--verde-acao); }

  .mesma-taxa { margin-top: var(--s-sm); font-size: var(--fs-small); color: var(--azul); font-weight: 600; }

  .avancar {
    margin-top: var(--s-lg);
    width: 100%;
    min-height: 56px;
    padding: 16px 24px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--verde-acao);
    color: var(--branco);
    font-family: var(--fonte);
    font-size: 1.0625rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 150ms ease-out;
  }
  .avancar:hover { background: var(--verde-acao-profundo); }

  .handoff {
    margin-top: var(--s-md);
    background: var(--amarelo-suave);
    border-radius: var(--r-lg);
    padding: var(--s-md) 18px;
  }
  .handoff h2 { font-size: 1.0625rem; font-weight: 700; margin-bottom: 4px; }
  .handoff p { font-size: var(--fs-small); line-height: 1.55; }

  .nota { margin-top: var(--s-md); text-align: center; font-size: var(--fs-micro); color: var(--cinza-medio); line-height: 1.5; }
</style>

<script>
  const form = document.getElementById('sim') as HTMLFormElement | null;
  const faixa = document.getElementById('valor') as HTMLInputElement | null;
  const handoff = document.getElementById('handoff');
  const taxa = Number(form?.dataset.taxa ?? 0);

  const brl = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const brlInteiro = (n: number) => 'R$ ' + n.toLocaleString('pt-BR', { maximumFractionDigits: 0 });
  const set = (id: string, texto: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = texto;
  };

  function calcular() {
    if (!faixa) return;
    const valor = Number(faixa.value);
    const n = Number(document.querySelector<HTMLInputElement>('input[name="parcelas"]:checked')?.value ?? 12);
    const p = (valor * taxa) / (1 - Math.pow(1 + taxa, -n));

    const min = Number(faixa.min);
    const max = Number(faixa.max);
    faixa.style.setProperty('--pct', `${((valor - min) / (max - min)) * 100}%`);
    faixa.setAttribute('aria-valuetext', brlInteiro(valor));

    set('saida-valor', brlInteiro(valor));
    set('r-recebe', brl(valor));
    set('r-n', `${n}x`);
    set('r-total', brl(p * n));
    set('r-parcela', `${n}x de ${brl(p)}`);
  }

  faixa?.addEventListener('input', calcular);
  document.querySelectorAll('input[name="parcelas"]').forEach((el) => el.addEventListener('change', calcular));

  /**
   * LIMITE DE ENTREGA — ponto único de passagem para a jornada de contratação.
   * Quando a URL real existir, troque o corpo desta função por um redirect que
   * leve valor, parcelas e os parâmetros de campanha (utm_*) da URL atual.
   * Nada mais no site precisa mudar.
   */
  function irParaContratacao() {
    if (handoff) {
      handoff.hidden = false;
      handoff.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  document.getElementById('avancar')?.addEventListener('click', irParaContratacao);
  calcular();
</script>
