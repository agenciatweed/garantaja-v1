---
import BaseLayout from '../layouts/BaseLayout.astro';
import Botao from '../components/Botao.astro';

const etapas = [
  { t: 'simule', d: 'escolha quanto quer receber e veja as opções de parcelamento.' },
  { t: 'faça seu cadastro', d: 'dados básicos, direto pelo celular.' },
  { t: 'confira as condições', d: 'valor recebido, parcelas e CET aparecem na tela antes de você confirmar.' },
  { t: 'use seu cartão', d: 'adquira um título de capitalização, parcelado no seu cartão.' },
  { t: 'o título vira garantia', d: 'o título é usado como garantia da operação. por isso ninguém precisa consultar seu score.' },
  { t: 'confirme sua identidade', d: 'uma selfie e a validação dos seus dados para garantir que é você mesmo.' },
  { t: 'assine digitalmente', d: 'a formalização é feita online e você recebe uma cópia.' },
  { t: 'acompanhe o processamento', d: 'você vê em que etapa a operação está, sem precisar ligar para ninguém.' },
  { t: 'receba o dinheiro', d: 'o valor é disponibilizado na sua conta, por Pix, conforme as condições apresentadas.' },
];
---

<BaseLayout
  title="Como funciona — Garanta Já"
  description="Do momento em que você simula até o dinheiro na conta: as etapas do Garanta Já explicadas sem termos difíceis."
>
  <div class="pagina">
    <a href="/" class="voltar">← início</a>
    <h1 class="t-pagina">como funciona, etapa por etapa.</h1>
    <p class="intro">do momento em que você simula até o dinheiro na conta. sem termos difíceis.</p>

    <ol class="etapas">
      {etapas.map((e, i) => (
        <li class:list={['etapa', { final: i === etapas.length - 1 }]}>
          <span class="numero" aria-hidden="true">{i + 1}</span>
          <div class="corpo">
            <h2>{e.t}</h2>
            <p>{e.d}</p>
          </div>
        </li>
      ))}
    </ol>

    <aside class="titulo-explicado">
      <h2>o que é o título de capitalização?</h2>
      <p>
        é um produto financeiro emitido por uma sociedade de capitalização. você compra o
        título no cartão, parcelado, e ele fica no seu nome.
      </p>
      <p>
        no Garanta Já ele é a garantia da operação — é por isso que o seu score não
        entra na conta. e ele ainda participa de sorteios.
      </p>
    </aside>

    <div class="acoes">
      <Botao href="/simulador">quero simular</Botao>
      <Botao href="/duvidas" variante="texto">tirar dúvidas</Botao>
    </div>
  </div>
</BaseLayout>

<style>
  .etapas { display: flex; flex-direction: column; }
  .etapa {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 20px;
    padding-bottom: 26px;
    position: relative;
  }
  .etapa:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 40px;
    bottom: 0;
    width: 2px;
    background: var(--linha);
  }
  .numero {
    position: relative;
    z-index: 1;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--amarelo);
    color: var(--azul);
    font-weight: 800;
    font-size: 1.0625rem;
    display: flex; align-items: center; justify-content: center;
  }
  .final .numero { background: var(--verde-acao); color: var(--branco); }
  .corpo { padding-top: 4px; }
  .corpo h2 { font-size: 1.1875rem; font-weight: 700; margin-bottom: 6px; }
  .corpo p { font-size: var(--fs-base); max-width: 58ch; }

  .titulo-explicado {
    margin-top: var(--s-md);
    background: var(--amarelo-suave);
    border-radius: var(--r-xl);
    padding: 26px;
    display: grid;
    gap: var(--s-sm);
  }
  .titulo-explicado h2 { font-size: 1.1875rem; font-weight: 700; }
  .titulo-explicado p { max-width: 62ch; }

  .acoes { margin-top: var(--s-xl); display: flex; gap: var(--s-sm); flex-wrap: wrap; }
</style>
