---
import BaseLayout from '../layouts/BaseLayout.astro';
import { empresa, contato } from '../data/preview';

const secoes = [
  { id: 'uso', t: 'uso do site', d: 'regras de uso deste site e da simulação.' },
  { id: 'credito', t: 'condições da operação', d: 'valores, custo efetivo total, encargos, prazos, regras de quitação antecipada e cancelamento, e as condições do título de capitalização que garante a operação — incluindo os sorteios.' },
  { id: 'estorno', t: 'estorno', d: 'como e em quanto tempo a compra do título é estornada no cartão quando a operação não é concluída.' },
  { id: 'atendimento', t: 'atendimento e ouvidoria', d: 'prazos de resposta, fluxo de reclamação e como escalar um caso não resolvido.' },
];
---

<BaseLayout
  title="Termos de uso — Garanta Já"
  description="Termos de uso do site e condições da operação do Garanta Já."
>
  <div class="pagina">
    <a href="/" class="voltar">← início</a>
    <h1 class="t-pagina">termos de uso.</h1>
    <p class="intro">
      os textos definitivos estão em elaboração jurídica. em vez de publicar um modelo
      genérico, a gente mostra o que vai estar aqui e quem responde por isso.
    </p>

    <div class="lista">
      {secoes.map((s) => (
        <section class="bloco" id={s.id}>
          <h2>{s.t}</h2>
          <p>{s.d}</p>
          <p class="estado">em elaboração jurídica · publicado antes do lançamento</p>
        </section>
      ))}
    </div>

    <dl class="responsavel tabular">
      <div><dt>razão social</dt><dd>{empresa.razaoSocial}</dd></div>
      <div><dt>cnpj</dt><dd>{empresa.cnpj}</dd></div>
      <div><dt>contato</dt><dd><a href={`mailto:${contato.email}`}>{contato.email}</a></dd></div>
    </dl>
  </div>
</BaseLayout>

<style>
  .lista { display: grid; gap: var(--s-lg); }
  .bloco { border-top: 1px solid var(--linha); padding-top: var(--s-lg); }
  .bloco h2 { font-size: 1.1875rem; font-weight: 700; margin-bottom: var(--s-xs); }
  .bloco p { max-width: 62ch; }
  .estado { margin-top: var(--s-xs); font-size: var(--fs-small); font-weight: 600; color: var(--azul); }
  .responsavel {
    margin-top: var(--s-2xl);
    background: var(--cinza-claro);
    border-radius: var(--r-xl);
    padding: 26px;
    display: grid;
    gap: var(--s-xs);
  }
  .responsavel > div { display: flex; justify-content: space-between; gap: var(--s-md); flex-wrap: wrap; }
  .responsavel dt { color: var(--cinza-medio); }
  .responsavel dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
</style>
