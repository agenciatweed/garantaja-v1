---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Botao from '../../components/Botao.astro';
import BlocoAzul from '../../components/BlocoAzul.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const outros = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 2);

const dataBR = post.data.data.toLocaleDateString('pt-BR', {
  day: '2-digit', month: 'long', year: 'numeric',
});
---

<BaseLayout title={`${post.data.titulo} — Garanta Já`} description={post.data.resumo} ogImage={post.data.imagem}>
  <article>
    <header class="secao-curta cabeca">
      <div class="container">
        <p class="meta tabular">{post.data.categoria} · {post.data.leitura} de leitura</p>
        <h1 class="t-headline titulo">{post.data.titulo}</h1>
        <p class="t-lead resumo">{post.data.resumo}</p>
        <p class="data tabular"><time datetime={post.data.data.toISOString()}>{dataBR}</time></p>
      </div>
    </header>

    <div class="container">
      <figure class="capa-foto">
        <img src={post.data.imagem} alt={post.data.imagemAlt} width="1536" height="768" fetchpriority="high" />
      </figure>
    </div>

    <div class="container">
      <div class="corpo">
        <Content />
      </div>
    </div>
  </article>

  <section class="secao">
    <div class="container">
      <BlocoAzul titulo="precisa resolver agora?">
        <p>
          o Garanta Já é crédito pequeno, garantido por um título de capitalização
          comprado no seu cartão. sem consulta ao spc, e com o custo na tela antes
          de você aceitar.
        </p>
        <Botao slot="acao" href="/simulador" variante="sobre-azul">simular agora</Botao>
      </BlocoAzul>
    </div>
  </section>

  {outros.length > 0 && (
    <section class="secao fundo-claro">
      <div class="container">
        <h2 class="t-headline">para ler depois</h2>
        <ul class="outros">
          {outros.map((p) => (
            <li>
              <a href={`/blog/${p.id}`}>
                <img src={p.data.imagem} alt={p.data.imagemAlt} width="1024" height="1024" loading="lazy" />
                <div>
                  <p class="meta tabular">{p.data.categoria}</p>
                  <h3 class="t-title">{p.data.titulo}</h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .cabeca { padding-bottom: var(--s-lg); }
  .meta {
    font-size: var(--fs-micro); font-weight: 500; letter-spacing: 0.06em;
    color: var(--azul); margin-bottom: var(--s-sm);
  }
  .titulo { max-width: 22ch; text-wrap: balance; }
  .resumo { margin-top: var(--s-md); color: var(--cinza-medio); }
  .data { margin-top: var(--s-md); font-size: var(--fs-small); color: var(--cinza-medio); }

  .capa-foto { margin: 0 0 var(--s-2xl); border-radius: var(--r-xl); overflow: hidden; background: var(--cinza-claro); }
  .capa-foto img { width: 100%; aspect-ratio: 2 / 1; object-fit: cover; }

  .corpo { max-width: 65ch; padding-bottom: var(--s-2xl); }
  .corpo :global(p) { margin-bottom: var(--s-lg); line-height: 1.7; }
  .corpo :global(h2) {
    font-size: var(--fs-subhead);
    font-weight: 700;
    letter-spacing: -0.018em;
    margin: var(--s-2xl) 0 var(--s-md);
    text-wrap: balance;
  }
  .corpo :global(ul), .corpo :global(ol) {
    margin: 0 0 var(--s-lg);
    padding-left: var(--s-lg);
    display: grid;
    gap: var(--s-sm);
  }
  .corpo :global(ul li) { list-style: none; position: relative; }
  .corpo :global(ul li)::before {
    content: '';
    position: absolute; left: calc(var(--s-lg) * -1); top: 0.62em;
    width: 8px; height: 8px; border-radius: 50%; background: var(--amarelo);
  }
  .corpo :global(ol) { list-style: decimal; }
  .corpo :global(ol li) { padding-left: var(--s-2xs); }
  .corpo :global(ol li::marker) { font-weight: 700; color: var(--azul); }
  .corpo :global(strong) { font-weight: 600; }
  .corpo :global(blockquote) {
    margin: var(--s-2xl) 0;
    padding: var(--s-lg);
    background: var(--amarelo-suave);
    border-radius: var(--r-lg);
    font-weight: 500;
  }
  .corpo :global(blockquote p) { margin: 0; }

  .outros { margin-top: var(--s-xl); display: grid; gap: var(--s-lg); }
  .outros a {
    display: flex; gap: var(--s-md); align-items: center;
    text-decoration: none; color: inherit;
  }
  .outros img {
    width: 96px; height: 96px; flex: none;
    object-fit: cover; border-radius: var(--r-md);
    background: var(--cinza-claro);
  }
  .outros h3 { text-wrap: balance; }
  .outros a:hover h3 { color: var(--azul); }

  @media (min-width: 768px) {
    .outros { grid-template-columns: 1fr 1fr; gap: var(--s-xl); }
  }
</style>
