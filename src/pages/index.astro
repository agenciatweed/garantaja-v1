---
import BaseLayout from '../layouts/BaseLayout.astro';
import Botao from '../components/Botao.astro';
import Acordeao from '../components/Acordeao.astro';
import ChamadaSimular from '../components/ChamadaSimular.astro';
import Bandeiras from '../components/Bandeiras.astro';
import BlocoAtendimento from '../components/BlocoAtendimento.astro';
import Participantes from '../components/Participantes.astro';
import BarraCta from '../components/BarraCta.astro';
import { fotos, condicoes, parcela, brl, brlInteiro } from '../data/preview';
import { faqHome } from '../data/faq';

const icones = {
  dinheiro: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
  carteira: 'M21 12V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-1M16 12h5',
  raio: 'M13 2 4 14h7l-1 8 9-12h-7l1-8z',
  celular: 'M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2',
  medidor: 'M12 14l4-4M3.34 19a10 10 0 1 1 17.32 0',
  bilhete: 'M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2ZM13 5v2M13 17v2M13 11v2',
};

const situacoes = [
  { t: 'precisa pagar via Pix', d: 'use o limite disponível do cartão para receber dinheiro na conta.', icon: icones.dinheiro },
  { t: 'o serviço não aceita cartão', d: 'com o dinheiro na conta, você paga do jeito que precisar.', icon: icones.carteira },
  { t: 'apareceu um imprevisto', d: 'resolva uma despesa pontual usando seu limite disponível.', icon: icones.raio },
];

const passos = [
  { n: 1, t: 'você diz quanto precisa', d: 'a simulação mostra o valor, o custo e as parcelas antes de qualquer decisão.' },
  { n: 2, t: 'use seu cartão', d: 'adquira um título de capitalização, parcelado no seu cartão.' },
  { n: 3, t: 'o título vira garantia', d: 'é ele que garante a operação. por isso ninguém precisa consultar seu score.' },
  { n: 4, t: 'confirme sua identidade', d: 'validação e formalização pelo celular.' },
  { n: 5, t: 'receba o dinheiro', d: 'concluída a operação, o valor cai por Pix conforme as condições.' },
];

const diferenciais = [
  { t: 'use seu limite disponível', d: 'transforme parte do limite do cartão em dinheiro na conta.', icon: icones.carteira },
  { t: 'receba por Pix', d: 'concluída a operação, o dinheiro é disponibilizado conforme as condições informadas.', icon: icones.dinheiro },
  { t: 'jornada digital', d: 'simulação, validação e formalização pelo celular.', icon: icones.celular },
  { t: 'sem consulta de score', d: 'quem garante a operação é o título de capitalização, não o seu histórico.', icon: icones.medidor },
  { t: 'concorra a sorteios', d: 'além de garantir a operação, o título de capitalização participa de sorteios.', icon: icones.bilhete, destaque: true },
];

const exemplo = condicoes.valorInicial;
const nExemplo = condicoes.parcelasIniciais;
const resumo = [
  { rotulo: 'valor solicitado', valor: brl(exemplo) },
  { rotulo: 'valor recebido por Pix', valor: brl(exemplo) },
  { rotulo: 'número de parcelas', valor: `${nExemplo}x` },
  { rotulo: 'valor da parcela', valor: brl(parcela(exemplo, nExemplo)) },
];
---

<BaseLayout
  title="Garanta Já — seu limite do cartão pode virar dinheiro no Pix"
  description="Use parte do limite disponível do cartão de crédito e receba por Pix. Sem consulta de score. Veja valor, parcelas e CET antes de decidir."
>

  <!-- herói -->
  <section class="container heroi">
    <div class="heroi-texto">
      <span class="selo"><span class="ponto" aria-hidden="true"></span>tem cartão e limite disponível?</span>
      <h1 class="t-hero">seu limite pode virar dinheiro na conta.</h1>
      <p class="t-lead">use parte do limite do cartão, receba por Pix e resolva o que o cartão não paga direto.</p>
      <div class="acoes">
        <Botao href="/simulador">simular agora</Botao>
        <Botao href="#como-funciona" variante="texto">ver como funciona</Botao>
      </div>
      <p class="nota">simular é grátis e não gera cobrança. você vê as condições antes de decidir.</p>
      <div class="trilha" aria-label="do cartão ao Pix">
        <span class="trilha-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3" /><path d="M2 10h20" /></svg>
          cartão
        </span>
        <svg class="seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        <span class="trilha-item">garanta já</span>
        <svg class="seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        <span class="trilha-item pix">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          dinheiro por Pix
        </span>
      </div>
    </div>

    <div class="heroi-foto">
      <div class="moldura">
        <img
          src={fotos.heroi}
          alt="mulher sentada no sofá de casa resolvendo um pagamento pelo celular"
          width="1024" height="1024"
          fetchpriority="high" decoding="async"
        />
      </div>
      <div class="flutuante">
        <span class="check" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
        </span>
        <span>
          <span class="flutuante-rotulo">recebe por Pix</span>
          <span class="flutuante-valor">até {brlInteiro(condicoes.valorMaximo)}</span>
        </span>
      </div>
    </div>
  </section>

  <!-- situações de uso -->
  <section class="container secao">
    <p class="olho">situações de uso</p>
    <h2 class="t-secao titulo">para quando o cartão não resolve.</h2>
    <p class="t-lead subtitulo">três situações do dia a dia em que o limite ajuda.</p>
    <ul class="grade-cards">
      {situacoes.map((s) => (
        <li class="cartao situacao">
          <span class="icone-caixa" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
          </span>
          <h3 class="t-card">{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- como funciona -->
  <section class="fundo-claro secao" id="como-funciona">
    <div class="container">
      <p class="olho">como funciona</p>
      <h2 class="t-secao titulo espaco-grande">do limite disponível ao dinheiro na sua conta.</h2>
      <ol class="passos">
        {passos.map((p) => (
          <li class:list={['passo', { final: p.n === passos.length }]}>
            <span class="passo-n" aria-hidden="true">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
      <div class="acoes espaco-acoes">
        <Botao href="/simulador">quero simular</Botao>
        <Botao href="/como-funciona" variante="contorno">ver etapa por etapa</Botao>
      </div>
    </div>
  </section>

  <!-- chamada para simulação -->
  <section class="container secao">
    <ChamadaSimular />
  </section>

  <!-- diferenciais -->
  <section class="container secao sem-topo">
    <h2 class="t-secao titulo espaco-grande">por que o garanta já.</h2>
    <ul class="diferenciais">
      {diferenciais.map((d) => (
        <li class:list={['diferencial', { destaque: d.destaque }]}>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d.icon} /></svg>
          <h3>{d.t}</h3>
          <p>{d.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- transparência -->
  <section class="fundo-claro secao">
    <div class="container transparencia">
      <div>
        <p class="olho">transparência</p>
        <h2 class="t-secao titulo">você sabe as condições antes de decidir.</h2>
        <p class="t-lead subtitulo">antes de confirmar, a tela mostra tudo o que você vai pagar. em linguagem simples, sem letra miúda escondida.</p>
        <div class="mesma-taxa">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
          <p><strong>a taxa é a mesma para qualquer perfil.</strong> ela não muda por causa do seu score ou do seu histórico — só varia conforme o valor que você escolhe.</p>
        </div>
        <Botao href="/simulador" variante="azul" tamanho="medio">ver condições de exemplo</Botao>
      </div>

      <div class="resumo">
        <div class="resumo-topo">
          <span class="resumo-titulo">resumo da operação</span>
          <span class="etiqueta">exemplo</span>
        </div>
        <dl class="tabular">
          {resumo.map((r) => (
            <div class="linha"><dt>{r.rotulo}</dt><dd>{r.valor}</dd></div>
          ))}
          <div class="linha cet">
            <dt>CET <span class="cet-extenso">custo efetivo total</span></dt>
            <dd>{condicoes.cetMensal}<span class="cet-ano">{condicoes.cetAnual}</span></dd>
          </div>
        </dl>
        <p class="resumo-nota">valores ilustrativos. as condições reais aparecem na simulação e estão sujeitas a homologação.</p>
      </div>
    </div>
  </section>

  <!-- cartões aceitos -->
  <section class="container secao">
    <Bandeiras />
  </section>

  <!-- dúvidas -->
  <section class="secao sem-topo">
    <div class="container estreito">
      <h2 class="t-secao titulo espaco-grande">dúvidas mais comuns.</h2>
      <Acordeao itens={faqHome} />
      <a href="/duvidas" class="link-seta">
        ver todas as dúvidas
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
      </a>
    </div>
  </section>

  <!-- atendimento -->
  <section class="container secao sem-topo">
    <BlocoAtendimento />
  </section>

  <!-- quem participa: discreto, no fim da página -->
  <section class="container secao sem-topo participantes">
    <p class="olho">confiança</p>
    <h2 class="titulo-discreto">quem participa da operação.</h2>
    <p class="subtitulo-discreto">o garanta já é a marca que acompanha você na experiência. empresas especializadas participam da estrutura da operação.</p>
    <Participantes />
  </section>

  <BarraCta />
</BaseLayout>

<style>
  /* herói */
  .heroi {
    padding-block: clamp(32px, 6vw, 72px) clamp(40px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }
  .heroi-texto {
    display: flex;
    flex-direction: column;
    gap: 22px;
    animation: subir 420ms ease-out both;
  }
  .selo {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--s-xs);
    background: var(--amarelo-suave);
    color: var(--azul);
    font-weight: 600;
    font-size: var(--fs-small);
    padding: 8px 16px;
    border-radius: var(--r-pill);
  }
  .ponto { width: 8px; height: 8px; border-radius: 50%; background: var(--amarelo); }
  .heroi .t-lead { max-width: 36ch; }
  .acoes { display: flex; gap: var(--s-sm); flex-wrap: wrap; align-items: center; }
  .nota { font-size: var(--fs-small); color: var(--cinza-medio); }
  .trilha {
    display: flex;
    align-items: center;
    gap: var(--s-sm);
    flex-wrap: wrap;
    border-top: 1px solid var(--linha);
    padding-top: 20px;
  }
  .trilha-item {
    display: inline-flex; align-items: center; gap: var(--s-xs);
    font-weight: 600; font-size: var(--fs-body-sm); color: var(--azul);
  }
  .trilha .seta { color: var(--amarelo-pressionado); }
  .trilha .pix { color: var(--verde-acao); font-weight: 700; }

  .heroi-foto { position: relative; animation: subir 520ms ease-out both; margin-bottom: 18px; }
  .moldura {
    border-radius: var(--r-2xl);
    overflow: hidden;
    background: var(--cinza-claro);
    aspect-ratio: 4 / 3;
  }
  .moldura img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .flutuante {
    position: absolute;
    left: -8px;
    bottom: -18px;
    background: var(--branco);
    border-radius: var(--r-xl);
    box-shadow: var(--sombra-elevada);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .check {
    width: 42px; height: 42px; border-radius: 50%;
    background: var(--verde-suave); color: var(--verde-acao);
    display: flex; align-items: center; justify-content: center;
  }
  .flutuante-rotulo { display: block; font-size: var(--fs-micro); color: var(--cinza-medio); font-weight: 500; }
  .flutuante-valor { display: block; font-size: 1.5rem; font-weight: 800; color: var(--azul); line-height: 1.15; }
  @media (max-width: 480px) {
    .flutuante { left: 12px; }
  }

  /* seções */
  .sem-topo { padding-top: 0; }
  .titulo { margin-bottom: 10px; max-width: 24ch; }
  .espaco-grande { margin-bottom: var(--s-xl); }
  .subtitulo { margin-bottom: var(--s-xl); }
  .estreito { max-width: 860px; }

  .grade-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 20px;
  }
  .situacao p { font-size: var(--fs-base); }
  .icone-caixa {
    display: flex; width: 46px; height: 46px; border-radius: 14px;
    background: var(--azul-suave); color: var(--azul);
    align-items: center; justify-content: center; margin-bottom: 18px;
  }

  /* passos */
  .passos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(196px, 100%), 1fr));
    gap: var(--s-md);
  }
  .passo {
    background: var(--branco);
    border-radius: var(--r-xl);
    padding: var(--s-lg);
    box-shadow: var(--sombra-card);
    border-top: 4px solid var(--amarelo);
    display: flex;
    flex-direction: column;
    gap: var(--s-sm);
  }
  .passo h3 { font-size: 1.125rem; font-weight: 700; }
  .passo p { font-size: var(--fs-body-sm); }
  .passo-n {
    display: flex; width: 40px; height: 40px; border-radius: 50%;
    background: var(--amarelo); color: var(--azul);
    font-weight: 800; font-size: 1.0625rem;
    align-items: center; justify-content: center;
  }
  .passo.final { border-top-color: var(--verde); }
  .passo.final .passo-n { background: var(--verde-acao); color: var(--branco); }
  .espaco-acoes { margin-top: var(--s-xl); }

  /* diferenciais */
  .diferenciais {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: var(--s-md);
  }
  .diferencial {
    background: var(--cinza-claro);
    border-radius: var(--r-xl);
    padding: 26px;
    color: var(--azul);
  }
  .diferencial svg { margin-bottom: var(--s-md); }
  .diferencial h3 { font-size: 1.125rem; font-weight: 700; margin-bottom: var(--s-xs); }
  .diferencial p { font-size: var(--fs-body-sm); color: var(--cinza-escuro); }
  .diferencial.destaque { background: var(--amarelo-suave); box-shadow: inset 0 0 0 2px var(--amarelo); }

  /* transparência */
  .transparencia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 36px;
    align-items: center;
  }
  .transparencia .subtitulo { margin-bottom: var(--s-lg); max-width: 40ch; }
  .mesma-taxa {
    display: flex;
    gap: var(--s-sm);
    align-items: flex-start;
    background: var(--branco);
    border-left: 4px solid var(--amarelo);
    border-radius: var(--r-md);
    padding: var(--s-md) 18px;
    margin-bottom: var(--s-lg);
    max-width: 46ch;
  }
  .mesma-taxa svg { flex: none; color: var(--azul); margin-top: 2px; }
  .mesma-taxa p { font-size: var(--fs-body-sm); line-height: 1.55; }
  .mesma-taxa strong { color: var(--azul); }

  .resumo {
    background: var(--branco);
    border-radius: var(--r-2xl);
    box-shadow: var(--sombra-elevada);
    padding: 26px 26px 20px;
  }
  .resumo-topo { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s-xs); }
  .resumo-titulo { font-size: var(--fs-small); font-weight: 700; color: var(--cinza-medio); }
  .etiqueta {
    font-size: 0.75rem; font-weight: 700;
    color: var(--verde-acao-profundo); background: var(--verde-suave);
    padding: 5px 10px; border-radius: var(--r-pill);
  }
  .linha {
    display: flex; justify-content: space-between; gap: var(--s-md);
    padding: 13px 0; border-bottom: 1px solid var(--linha);
  }
  .linha dt { font-weight: 500; }
  .linha dd { margin: 0; color: var(--azul); font-weight: 700; text-align: right; }
  .linha.cet {
    background: var(--azul-suave);
    border-bottom: 0;
    border-radius: var(--r-md);
    padding: 14px 16px;
    margin: 12px -8px 0;
    align-items: center;
  }
  .cet dt { font-weight: 800; color: var(--azul); }
  .cet-extenso { display: block; font-size: var(--fs-micro); font-weight: 500; color: var(--cinza-medio); }
  .cet dd { font-size: 1.25rem; font-weight: 800; }
  .cet-ano { display: block; font-size: var(--fs-micro); font-weight: 600; color: var(--cinza-medio); }
  .resumo-nota { font-size: var(--fs-micro); color: var(--cinza-medio); margin-top: var(--s-md); }

  /* dúvidas */
  .link-seta {
    margin-top: 22px;
    display: inline-flex; align-items: center; gap: var(--s-xs);
    min-height: 44px;
    font-weight: 700; text-decoration: none;
  }
  .link-seta:hover { text-decoration: underline; }

  /* quem participa */
  .participantes { padding-top: clamp(24px, 4vw, 40px); }
  .titulo-discreto { font-size: clamp(1.375rem, 2.4vw, 1.75rem); font-weight: 800; margin-bottom: var(--s-xs); }
  .subtitulo-discreto { color: var(--cinza-medio); max-width: 60ch; margin-bottom: var(--s-lg); }
</style>
